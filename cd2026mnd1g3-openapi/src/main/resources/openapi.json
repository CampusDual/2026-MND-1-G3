{
  "openapi": "3.1.0",
  "info": { "title": "VetControl B2B", "version": "2.0.0" },
  "servers": [{ "url": "http://localhost:8080" }],
  "security": [{ "basicAuth": [] }],
  "paths": {
    "/api/explotaciones": {
      "get": { "responses": { "200": { "description": "Explotaciones", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Farm" } } } } } } },
      "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Farm" } } } }, "responses": { "201": { "description": "Creada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Farm" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" } } }
    },
    "/api/ganaderia/animales": {
      "get": { "responses": { "200": { "description": "Animales", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Animal" } } } } } } },
      "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Animal" } } } }, "responses": { "201": { "description": "Creado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Animal" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" } } }
    },
    "/api/ganaderia/animales/{animalId}/estado": {
      "post": { "parameters": [{ "name": "animalId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }, { "name": "estado", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/EstadoSanitario" } }], "responses": { "204": { "description": "Estado actualizado" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/api/protocolos-ciclicos": {
      "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProtocolEvent" } } } }, "responses": { "201": { "description": "Protocolo registrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProtocolEvent" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" } } }
    },
    "/api/alertas": {
      "get": { "responses": { "200": { "description": "Alertas internas", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/AlertaSistema" } } } } } } }
    },
    "/api/alertas/{id}/leida": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/AlertId" }], "responses": { "200": { "description": "Alerta marcada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AlertaSistema" } } } }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/api/alertas/{id}/confirmar-granja": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/AlertId" }], "responses": { "200": { "description": "Confirmada por granja", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AlertaSistema" } } } }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/api/inventario/medicamentos": {
      "get": { "responses": { "200": { "description": "Medicamentos", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Medicamento" } } } } } } }
    },
    "/api/inventario/lotes": {
      "get": { "responses": { "200": { "description": "Lotes de stock", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/LoteStock" } } } } } } }
    },
    "/api/inventario/movimientos": {
      "get": { "responses": { "200": { "description": "Ledger", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MovimientoInventario" } } } } } } },
      "post": { "parameters": [{ "name": "loteStockId", "in": "query", "required": true, "schema": { "type": "integer", "format": "int64" } }, { "name": "cantidad", "in": "query", "required": true, "schema": { "type": "number", "minimum": 0.0001 } }, { "name": "tipo", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/TipoMovimiento" } }], "responses": { "200": { "description": "Movimiento registrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MovimientoInventario" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" } } }
    }
  },
  "components": {
    "securitySchemes": { "basicAuth": { "type": "http", "scheme": "basic" } },
    "parameters": { "AlertId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64", "minimum": 1 } } },
    "responses": {
      "BadRequest": { "description": "Datos inválidos" },
      "Unauthorized": { "description": "No autenticado" },
      "Forbidden": { "description": "Acceso denegado por pertenencia o rol" },
      "NotFound": { "description": "Recurso no encontrado" },
      "Conflict": { "description": "Conflicto de estado" },
      "Unprocessable": { "description": "Entidad semánticamente inválida" },
      "InternalServer": { "description": "Error interno" }
    },
    "schemas": {
      "Farm": { "type": "object", "required": ["name", "regaCode", "mainSpecies", "managerName"], "properties": { "id": { "type": "integer", "format": "int64" }, "clinicaId": { "type": "integer", "format": "int64", "default": 1 }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "regaCode": { "type": "string", "minLength": 1, "maxLength": 30 }, "mainSpecies": { "$ref": "#/components/schemas/Species" }, "managerName": { "type": "string", "minLength": 1, "maxLength": 120 } } },
      "Animal": { "type": "object", "required": ["earTag", "species", "birthDate", "healthStatus", "farmId"], "properties": { "id": { "type": "integer", "format": "int64" }, "earTag": { "type": "string", "maxLength": 40 }, "name": { "type": "string", "maxLength": 100 }, "species": { "$ref": "#/components/schemas/Species" }, "birthDate": { "type": "string", "format": "date" }, "healthStatus": { "type": "string" }, "estadoSanitario": { "$ref": "#/components/schemas/EstadoSanitario" }, "farmId": { "type": "integer", "format": "int64" } } },
      "ProtocolEvent": { "type": "object", "required": ["eventType", "title", "applicationDate", "withdrawalDays", "farmId"], "properties": { "id": { "type": "integer", "format": "int64" }, "eventType": { "type": "string" }, "title": { "type": "string", "maxLength": 150 }, "medication": { "type": "string", "maxLength": 120 }, "medicationBatch": { "type": "string", "maxLength": 120 }, "applicationDate": { "type": "string", "format": "date" }, "withdrawalDays": { "type": "integer", "minimum": 0 }, "nextCycleDays": { "type": "integer", "minimum": 0 }, "loteStockId": { "type": "integer", "format": "int64" }, "cantidadUsada": { "type": "number", "minimum": 0.0001 }, "animalId": { "type": "integer", "format": "int64" }, "farmId": { "type": "integer", "format": "int64" } } },
      "AlertaSistema": { "type": "object", "properties": { "id": { "type": "integer", "format": "int64" }, "clinicaId": { "type": "integer", "format": "int64" }, "destinatarioRol": { "type": "string", "enum": ["VETERINARIAN", "FARM_MANAGER", "CLINIC_ADMIN"] }, "tipoAlerta": { "type": "string", "enum": ["RECORDATORIO_CICLICO", "FIN_RETIRADA_MEDICAMENTO", "URGENCIA_ANIMAL_ENFERMO", "STOCK_BAJO"] }, "titulo": { "type": "string" }, "mensaje": { "type": "string" }, "fechaProgramada": { "type": "string", "format": "date-time" }, "leida": { "type": "boolean" }, "confirmadaPorGranja": { "type": "boolean" }, "explotacionId": { "type": "integer", "format": "int64", "nullable": true }, "animalId": { "type": "integer", "format": "int64", "nullable": true } } },
      "Medicamento": { "type": "object", "required": ["nombreComercial", "principioActivo", "especieDestino", "categoriaPran", "diasRetiradaDefecto", "stockMinimoAlerta"], "properties": { "id": { "type": "integer", "format": "int64" }, "clinicaId": { "type": "integer", "format": "int64" }, "nombreComercial": { "type": "string" }, "principioActivo": { "type": "string" }, "especieDestino": { "type": "string" }, "categoriaPran": { "type": "string", "enum": ["A", "B", "C", "D"] }, "diasRetiradaDefecto": { "type": "integer", "minimum": 0 }, "stockMinimoAlerta": { "type": "number", "minimum": 0 } } },
      "LoteStock": { "type": "object", "required": ["medicamentoId", "numeroLote", "fechaCaducidad", "proveedor"], "properties": { "id": { "type": "integer", "format": "int64" }, "medicamentoId": { "type": "integer", "format": "int64" }, "numeroLote": { "type": "string", "maxLength": 80 }, "fechaCaducidad": { "type": "string", "format": "date" }, "proveedor": { "type": "string", "maxLength": 150 } } },
      "MovimientoInventario": { "type": "object", "properties": { "id": { "type": "integer", "format": "int64" }, "clinicaId": { "type": "integer", "format": "int64" }, "loteStockId": { "type": "integer", "format": "int64" }, "tipoMovimiento": { "$ref": "#/components/schemas/TipoMovimiento" }, "cantidad": { "type": "number" }, "fechaHora": { "type": "string", "format": "date-time" }, "veterinarioId": { "type": "integer", "format": "int64", "nullable": true }, "animalId": { "type": "integer", "format": "int64", "nullable": true }, "explotacionId": { "type": "integer", "format": "int64", "nullable": true }, "protocoloEventoId": { "type": "integer", "format": "int64", "nullable": true } } },
      "TipoMovimiento": { "type": "string", "enum": ["ENTRADA_COMPRA", "SALIDA_GANADERIA", "SALIDA_CLINICA", "MERMA_CADUCIDAD", "AJUSTE_ANULACION"] },
      "EstadoSanitario": { "type": "string", "enum": ["SANO", "ENFERMO", "CUARENTENA", "EN_RETIRADA_MEDICAMENTO", "TRATAMIENTO_FINALIZADO"] },
      "Species": { "type": "string", "enum": ["VACUNO_LECHE", "VACUNO_CARNE", "PORCINO", "OVINO", "CAPRINO", "AVICOLA", "EQUINO", "OTRO"] }
    }
  }
}
