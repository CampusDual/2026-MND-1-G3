{
  "openapi": "3.1.0",
  "info": {
    "title": "Plataforma veterinaria ganadera",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:8080" }
  ],
  "security": [
    { "basicAuth": [] }
  ],
  "paths": {
    "/api/explotaciones": {
      "get": {
        "operationId": "listFarms",
        "responses": {
          "200": {
            "description": "Explotaciones",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Farm" } } } }
          }
        }
      },
      "post": {
        "operationId": "createFarm",
        "requestBody": { "$ref": "#/components/requestBodies/Farm" },
        "responses": {
          "201": { "description": "Creada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Farm" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/animales": {
      "get": {
        "operationId": "listAnimals",
        "responses": {
          "200": {
            "description": "Animales",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Animal" } } } }
          }
        }
      },
      "post": {
        "operationId": "createAnimal",
        "requestBody": { "$ref": "#/components/requestBodies/Animal" },
        "responses": {
          "201": { "description": "Creado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Animal" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/protocolos": {
      "get": {
        "operationId": "listProtocolEvents",
        "responses": {
          "200": {
            "description": "Protocolos",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProtocolEvent" } } } }
          }
        }
      },
      "post": {
        "operationId": "createProtocolEvent",
        "requestBody": { "$ref": "#/components/requestBodies/ProtocolEvent" },
        "responses": {
          "201": { "description": "Creado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProtocolEvent" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/protocolos-ciclicos": {
      "post": {
        "operationId": "registerCyclicProtocol",
        "requestBody": { "$ref": "#/components/requestBodies/ProtocolEvent" },
        "responses": {
          "201": { "description": "Protocolo registrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProtocolEvent" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/protocolos-ciclicos/animales/{animalId}/estado": {
      "post": {
        "operationId": "updateAnimalHealthStatus",
        "parameters": [
          { "name": "animalId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64", "minimum": 1 } },
          { "name": "estado", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/EstadoSanitario" } },
          { "name": "notas", "in": "query", "schema": { "type": "string", "maxLength": 1000 } }
        ],
        "responses": {
          "204": { "description": "Estado actualizado" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/protocolos-ciclicos/ejecutar-revision-diaria": {
      "post": {
        "operationId": "runDailyProtocolReview",
        "responses": { "204": { "description": "Revisión ejecutada" } }
      }
    },
    "/api/notificaciones": {
      "get": {
        "operationId": "listNotifications",
        "responses": {
          "200": {
            "description": "Cola de notificaciones WhatsApp",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/WhatsAppNotification" } } } }
          }
        }
      }
    },
    "/api/notificaciones/{id}/simular-envio": {
      "post": {
        "operationId": "simulateSend",
        "parameters": [ { "$ref": "#/components/parameters/NotificationId" } ],
        "responses": {
          "200": { "description": "Enviada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WhatsAppNotification" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/notificaciones/{id}/simular-confirmacion-ganadero": {
      "post": {
        "operationId": "simulateFarmerConfirmation",
        "parameters": [ { "$ref": "#/components/parameters/NotificationId" } ],
        "responses": {
          "200": { "description": "Confirmada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WhatsAppNotification" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/notificaciones/{id}/simular-respuesta-ganadero": {
      "post": {
        "operationId": "simulateFarmerResponse",
        "parameters": [ { "$ref": "#/components/parameters/NotificationId" } ],
        "responses": {
          "200": { "description": "Confirmada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WhatsAppNotification" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": { "type": "http", "scheme": "basic" }
    },
    "parameters": {
      "NotificationId": {
        "name": "id", "in": "path", "required": true,
        "schema": { "type": "integer", "format": "int64", "minimum": 1 }
      }
    },
    "requestBodies": {
      "Farm": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Farm" } } } },
      "Animal": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Animal" } } } },
      "ProtocolEvent": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProtocolEvent" } } } }
    },
    "responses": {
      "BadRequest": { "description": "Datos inválidos" },
      "NotFound": { "description": "Recurso no encontrado" }
    },
    "schemas": {
      "Farm": {
        "type": "object",
        "required": [ "name", "regaCode", "mainSpecies", "managerName", "whatsappPhone" ],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "regaCode": { "type": "string", "minLength": 1, "maxLength": 30 },
          "mainSpecies": { "$ref": "#/components/schemas/Species" },
          "managerName": { "type": "string", "minLength": 1, "maxLength": 120 },
          "whatsappPhone": { "type": "string", "minLength": 7, "maxLength": 30 },
          "veterinarianAssignedPhone": { "type": "string", "maxLength": 30 }
        }
      },
      "Animal": {
        "type": "object",
        "required": [ "earTag", "species", "birthDate", "healthStatus", "farmId" ],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "earTag": { "type": "string", "minLength": 1, "maxLength": 40 },
          "name": { "type": "string", "maxLength": 100 },
          "species": { "$ref": "#/components/schemas/Species" },
          "birthDate": { "type": "string", "format": "date" },
          "healthStatus": { "type": "string" },
          "estadoSanitario": { "$ref": "#/components/schemas/EstadoSanitario" },
          "fechaFinRetirada": { "type": "string", "format": "date", "nullable": true },
          "notas": { "type": "string", "maxLength": 1000 },
          "farmId": { "type": "integer", "format": "int64", "minimum": 1 }
        }
      },
      "ProtocolEvent": {
        "type": "object",
        "required": [ "eventType", "title", "applicationDate", "withdrawalDays", "farmId" ],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "eventType": { "type": "string", "enum": [ "VACUNACION", "REVISION", "REVISION_PERIODICA", "TRATAMIENTO", "TRATAMIENTO_MEDICO", "PARTO", "SANEAMIENTO" ] },
          "title": { "type": "string", "minLength": 1, "maxLength": 150 },
          "medication": { "type": "string", "maxLength": 120 },
          "medicationBatch": { "type": "string", "maxLength": 120 },
          "applicationDate": { "type": "string", "format": "date" },
          "withdrawalDays": { "type": "integer", "minimum": 0 },
          "withdrawalEndDate": { "type": "string", "format": "date", "readOnly": true },
          "nextCycleDays": { "type": "integer", "minimum": 0, "default": 0 },
          "nextReminderDays": { "type": "integer", "minimum": 1, "nullable": true },
          "status": { "type": "string", "enum": [ "PROGRAMADO", "APLICADO", "PENDIENTE_REVISION", "VENCIDO" ] },
          "animalId": { "type": "integer", "format": "int64", "minimum": 1 },
          "farmId": { "type": "integer", "format": "int64", "minimum": 1 }
        }
      },
      "WhatsAppNotification": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "destinationPhone": { "type": "string", "maxLength": 30 },
          "message": { "type": "string", "maxLength": 1000 },
          "scheduledAt": { "type": "string", "format": "date-time" },
          "sentAt": { "type": "string", "format": "date-time", "nullable": true },
          "sendStatus": { "type": "string", "enum": [ "PENDIENTE", "ENVIADO", "CONFIRMADO_GANADERO" ] },
          "protocolEventId": { "type": "integer", "format": "int64" }
        }
      },
      "Species": {
        "type": "string",
        "enum": [ "VACUNO_LECHE", "VACUNO_CARNE", "PORCINO", "OVINO" ]
      },
      "EstadoSanitario": {
        "type": "string",
        "enum": [ "SANO", "EN_TRATAMIENTO", "EN_RETIRADA_MEDICAMENTO", "ENFERMO", "CUARENTENA" ]
      }
    }
  }
}
