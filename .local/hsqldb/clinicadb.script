CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC."flyway_schema_history"("installed_rank" INTEGER NOT NULL,"version" VARCHAR(50),"description" VARCHAR(200) NOT NULL,"type" VARCHAR(20) NOT NULL,"script" VARCHAR(1000) NOT NULL,"checksum" INTEGER,"installed_by" VARCHAR(100) NOT NULL,"installed_on" TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,"execution_time" INTEGER NOT NULL,"success" BIT(1) NOT NULL,CONSTRAINT "flyway_schema_history_pk" PRIMARY KEY("installed_rank"))
CREATE INDEX "flyway_schema_history_s_idx" ON PUBLIC."flyway_schema_history"("success")
CREATE MEMORY TABLE PUBLIC.PROPIETARIOS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,NOMBRE VARCHAR(80) NOT NULL,APELLIDOS VARCHAR(120) NOT NULL,TELEFONO_E164 VARCHAR(20),EMAIL VARCHAR(160),DNI VARCHAR(20))
ALTER TABLE PUBLIC.PROPIETARIOS ALTER COLUMN ID RESTART WITH 0
CREATE INDEX IDX_PROPIETARIOS_CLINICA_NOMBRE ON PUBLIC.PROPIETARIOS(CLINICA_ID,NOMBRE,APELLIDOS)
CREATE MEMORY TABLE PUBLIC.PACIENTE_MASCOTAS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,PROPIETARIO_ID BIGINT NOT NULL,NOMBRE VARCHAR(100),ESPECIE VARCHAR(30) NOT NULL,RAZA VARCHAR(100),MICROCHIP VARCHAR(30),FECHA_NACIMIENTO DATE,ESTADO_VACUNAL VARCHAR(30) NOT NULL,PROXIMA_VACUNA DATE,FOREIGN KEY(PROPIETARIO_ID) REFERENCES PUBLIC.PROPIETARIOS(ID))
ALTER TABLE PUBLIC.PACIENTE_MASCOTAS ALTER COLUMN ID RESTART WITH 0
CREATE INDEX IDX_PACIENTES_CLINICA_SPECIES_BREED ON PUBLIC.PACIENTE_MASCOTAS(CLINICA_ID,ESPECIE,RAZA)
CREATE INDEX IDX_PACIENTES_CLINICA_MICROCHIP ON PUBLIC.PACIENTE_MASCOTAS(CLINICA_ID,MICROCHIP)
CREATE MEMORY TABLE PUBLIC.CONSULTAS_CLINICA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,MASCOTA_ID BIGINT NOT NULL,FECHA TIMESTAMP NOT NULL,MOTIVO VARCHAR(500),DIAGNOSTICO VARCHAR(1000),FOREIGN KEY(MASCOTA_ID) REFERENCES PUBLIC.PACIENTE_MASCOTAS(ID))
ALTER TABLE PUBLIC.CONSULTAS_CLINICA ALTER COLUMN ID RESTART WITH 0
CREATE MEMORY TABLE PUBLIC.RECETAS_CLINICA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CONSULTA_ID BIGINT NOT NULL,MEDICAMENTO VARCHAR(150) NOT NULL,DOSIS VARCHAR(120),INDICACIONES VARCHAR(500),FOREIGN KEY(CONSULTA_ID) REFERENCES PUBLIC.CONSULTAS_CLINICA(ID))
ALTER TABLE PUBLIC.RECETAS_CLINICA ALTER COLUMN ID RESTART WITH 0
