CREATE USER SA PASSWORD DIGEST 'd41d8cd98f00b204e9800998ecf8427e'
ALTER USER SA SET LOCAL TRUE
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC."flyway_schema_history"("installed_rank" INTEGER NOT NULL,"version" VARCHAR(50),"description" VARCHAR(200) NOT NULL,"type" VARCHAR(20) NOT NULL,"script" VARCHAR(1000) NOT NULL,"checksum" INTEGER,"installed_by" VARCHAR(100) NOT NULL,"installed_on" TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,"execution_time" INTEGER NOT NULL,"success" BIT(1) NOT NULL,CONSTRAINT "flyway_schema_history_pk" PRIMARY KEY("installed_rank"))
CREATE INDEX "flyway_schema_history_s_idx" ON PUBLIC."flyway_schema_history"("success")
CREATE MEMORY TABLE PUBLIC.ROLES(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(80) NOT NULL,UNIQUE(NAME))
ALTER TABLE PUBLIC.ROLES ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.USERS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,USERNAME VARCHAR(80) NOT NULL,PASSWORD VARCHAR(120) NOT NULL,ENABLED BOOLEAN NOT NULL,NAME VARCHAR(120),PHONE VARCHAR(30),EMAIL VARCHAR(160),APP_ROLE VARCHAR(30),UNIQUE(USERNAME))
ALTER TABLE PUBLIC.USERS ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.USER_ROLES(USER_ID BIGINT NOT NULL,ROLE_ID BIGINT NOT NULL,CONSTRAINT PK_USER_ROLES PRIMARY KEY(USER_ID,ROLE_ID),CONSTRAINT FK_USER_ROLES_USER FOREIGN KEY(USER_ID) REFERENCES PUBLIC.USERS(ID),CONSTRAINT FK_USER_ROLES_ROLE FOREIGN KEY(ROLE_ID) REFERENCES PUBLIC.ROLES(ID))
CREATE MEMORY TABLE PUBLIC.FARMS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(120) NOT NULL,REGA_CODE VARCHAR(30) NOT NULL,MAIN_SPECIES VARCHAR(30) NOT NULL,MANAGER_NAME VARCHAR(120) NOT NULL,WHATSAPP_PHONE VARCHAR(30) NOT NULL,VETERINARIAN_ASSIGNED_PHONE VARCHAR(30),UNIQUE(REGA_CODE))
ALTER TABLE PUBLIC.FARMS ALTER COLUMN ID RESTART WITH 2
CREATE MEMORY TABLE PUBLIC.ANIMALS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,EAR_TAG VARCHAR(40) NOT NULL,NAME VARCHAR(100),SPECIES VARCHAR(30) NOT NULL,BIRTH_DATE DATE NOT NULL,HEALTH_STATUS VARCHAR(30) NOT NULL,FARM_ID BIGINT NOT NULL,ESTADO_SANITARIO VARCHAR(40) DEFAULT 'SANO' NOT NULL,FECHA_FIN_RETIRADA DATE,NOTAS VARCHAR(1000),UNIQUE(EAR_TAG),CONSTRAINT FK_ANIMALS_FARM FOREIGN KEY(FARM_ID) REFERENCES PUBLIC.FARMS(ID))
ALTER TABLE PUBLIC.ANIMALS ALTER COLUMN ID RESTART WITH 4
CREATE MEMORY TABLE PUBLIC.PROTOCOL_EVENTS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,EVENT_TYPE VARCHAR(30) NOT NULL,TITLE VARCHAR(150) NOT NULL,MEDICATION VARCHAR(120),APPLICATION_DATE DATE NOT NULL,WITHDRAWAL_DAYS INTEGER NOT NULL,WITHDRAWAL_END_DATE DATE,NEXT_REMINDER_DAYS INTEGER,STATUS VARCHAR(30) NOT NULL,ANIMAL_ID BIGINT,FARM_ID BIGINT NOT NULL,MEDICATION_BATCH VARCHAR(120),NEXT_CYCLE_DAYS INTEGER DEFAULT 0 NOT NULL,CONSTRAINT FK_PROTOCOL_ANIMAL FOREIGN KEY(ANIMAL_ID) REFERENCES PUBLIC.ANIMALS(ID),CONSTRAINT FK_PROTOCOL_FARM FOREIGN KEY(FARM_ID) REFERENCES PUBLIC.FARMS(ID))
ALTER TABLE PUBLIC.PROTOCOL_EVENTS ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.WHATSAPP_NOTIFICATIONS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,DESTINATION_PHONE VARCHAR(30) NOT NULL,MESSAGE VARCHAR(1000) NOT NULL,SCHEDULED_AT TIMESTAMP NOT NULL,SENT_AT TIMESTAMP,SEND_STATUS VARCHAR(30) NOT NULL,PROTOCOL_EVENT_ID BIGINT NOT NULL,CONSTRAINT FK_NOTIFICATION_PROTOCOL FOREIGN KEY(PROTOCOL_EVENT_ID) REFERENCES PUBLIC.PROTOCOL_EVENTS(ID))
ALTER TABLE PUBLIC.WHATSAPP_NOTIFICATIONS ALTER COLUMN ID RESTART WITH 3
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
SET DATABASE DEFAULT INITIAL SCHEMA PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CARDINAL_NUMBER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.YES_OR_NO TO PUBLIC
