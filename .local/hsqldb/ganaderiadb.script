ALTER TABLE PUBLIC.ANIMALS ALTER COLUMN ID RESTART WITH 0
CREATE INDEX IDX_ANIMALS_FARM ON PUBLIC.ANIMALS(FARM_ID)
CREATE INDEX IDX_ANIMALS_CLINICA ON PUBLIC.ANIMALS(SPECIES,BREED)
CREATE MEMORY TABLE PUBLIC.PROTOCOL_EVENTS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,EVENT_TYPE VARCHAR(30) NOT NULL,TITLE VARCHAR(150) NOT NULL,APPLICATION_DATE DATE NOT NULL,WITHDRAWAL_DAYS INTEGER NOT NULL,WITHDRAWAL_END_DATE DATE,NEXT_CYCLE_DAYS INTEGER,STATUS VARCHAR(30) NOT NULL,ANIMAL_ID BIGINT,FARM_ID BIGINT NOT NULL,FOREIGN KEY(ANIMAL_ID) REFERENCES PUBLIC.ANIMALS(ID),FOREIGN KEY(FARM_ID) REFERENCES PUBLIC.FARMS(ID))
ALTER TABLE PUBLIC.PROTOCOL_EVENTS ALTER COLUMN ID RESTART WITH 0
CREATE INDEX IDX_PROTOCOL_CLINICA ON PUBLIC.PROTOCOL_EVENTS(CLINICA_ID)
