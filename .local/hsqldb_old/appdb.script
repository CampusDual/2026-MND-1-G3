ALTER USER SA SET LOCAL TRUE
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC."flyway_schema_history"("installed_rank" INTEGER NOT NULL,"version" VARCHAR(50),"description" VARCHAR(200) NOT NULL,"type" VARCHAR(20) NOT NULL,"script" VARCHAR(1000) NOT NULL,"checksum" INTEGER,"installed_by" VARCHAR(100) NOT NULL,"installed_on" TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,"execution_time" INTEGER NOT NULL,"success" BIT(1) NOT NULL,CONSTRAINT "flyway_schema_history_pk" PRIMARY KEY("installed_rank"))
CREATE INDEX "flyway_schema_history_s_idx" ON PUBLIC."flyway_schema_history"("success")
CREATE MEMORY TABLE PUBLIC.ROLES(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(80) NOT NULL,UNIQUE(NAME))
ALTER TABLE PUBLIC.ROLES ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.USERS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,USERNAME VARCHAR(80) NOT NULL,PASSWORD VARCHAR(120) NOT NULL,ENABLED BOOLEAN NOT NULL,NAME VARCHAR(120),PHONE VARCHAR(30),EMAIL VARCHAR(160),APP_ROLE VARCHAR(30),CLINICA_ID BIGINT DEFAULT 1 NOT NULL,UNIQUE(USERNAME))
ALTER TABLE PUBLIC.USERS ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.USER_ROLES(USER_ID BIGINT NOT NULL,ROLE_ID BIGINT NOT NULL,CONSTRAINT PK_USER_ROLES PRIMARY KEY(USER_ID,ROLE_ID),CONSTRAINT FK_USER_ROLES_USER FOREIGN KEY(USER_ID) REFERENCES PUBLIC.USERS(ID),CONSTRAINT FK_USER_ROLES_ROLE FOREIGN KEY(ROLE_ID) REFERENCES PUBLIC.ROLES(ID))
CREATE MEMORY TABLE PUBLIC.FARMS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(120) NOT NULL,REGA_CODE VARCHAR(30) NOT NULL,MAIN_SPECIES VARCHAR(30) NOT NULL,MANAGER_NAME VARCHAR(120) NOT NULL,VETERINARIAN_ASSIGNED_PHONE VARCHAR(30),CLINICA_ID BIGINT DEFAULT 1 NOT NULL,UNIQUE(REGA_CODE))
ALTER TABLE PUBLIC.FARMS ALTER COLUMN ID RESTART WITH 2
CREATE MEMORY TABLE PUBLIC.ANIMALS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,EAR_TAG VARCHAR(40) NOT NULL,NAME VARCHAR(100),SPECIES VARCHAR(30) NOT NULL,BIRTH_DATE DATE NOT NULL,HEALTH_STATUS VARCHAR(30) NOT NULL,FARM_ID BIGINT NOT NULL,ESTADO_SANITARIO VARCHAR(40) DEFAULT 'SANO' NOT NULL,FECHA_FIN_RETIRADA DATE,NOTAS VARCHAR(1000),UNIQUE(EAR_TAG),CONSTRAINT FK_ANIMALS_FARM FOREIGN KEY(FARM_ID) REFERENCES PUBLIC.FARMS(ID))
ALTER TABLE PUBLIC.ANIMALS ALTER COLUMN ID RESTART WITH 4
CREATE MEMORY TABLE PUBLIC.PROTOCOL_EVENTS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,EVENT_TYPE VARCHAR(30) NOT NULL,TITLE VARCHAR(150) NOT NULL,MEDICATION VARCHAR(120),APPLICATION_DATE DATE NOT NULL,WITHDRAWAL_DAYS INTEGER NOT NULL,WITHDRAWAL_END_DATE DATE,NEXT_REMINDER_DAYS INTEGER,STATUS VARCHAR(30) NOT NULL,ANIMAL_ID BIGINT,FARM_ID BIGINT NOT NULL,MEDICATION_BATCH VARCHAR(120),NEXT_CYCLE_DAYS INTEGER DEFAULT 0 NOT NULL,LOTE_STOCK_ID BIGINT,CANTIDAD_USADA DOUBLE,CONSTRAINT FK_PROTOCOL_ANIMAL FOREIGN KEY(ANIMAL_ID) REFERENCES PUBLIC.ANIMALS(ID),CONSTRAINT FK_PROTOCOL_FARM FOREIGN KEY(FARM_ID) REFERENCES PUBLIC.FARMS(ID))
ALTER TABLE PUBLIC.PROTOCOL_EVENTS ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.ALERTAS_SISTEMA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,DESTINATARIO_ROL VARCHAR(30) NOT NULL,TIPO_ALERTA VARCHAR(40) NOT NULL,TITULO VARCHAR(150) NOT NULL,MENSAJE VARCHAR(1000) NOT NULL,FECHA_PROGRAMADA TIMESTAMP NOT NULL,LEIDA BOOLEAN DEFAULT FALSE NOT NULL,CONFIRMADA_POR_GRANJA BOOLEAN DEFAULT FALSE NOT NULL,EXPLOTACION_ID BIGINT,ANIMAL_ID BIGINT)
ALTER TABLE PUBLIC.ALERTAS_SISTEMA ALTER COLUMN ID RESTART WITH 0
CREATE MEMORY TABLE PUBLIC.MEDICAMENTOS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,NOMBRE_COMERCIAL VARCHAR(150) NOT NULL,PRINCIPIO_ACTIVO VARCHAR(150) NOT NULL,ESPECIE_DESTINO VARCHAR(30) NOT NULL,CATEGORIA_PRAN VARCHAR(5) NOT NULL,DIAS_RETIRADA_DEFECTO INTEGER NOT NULL,STOCK_MINIMO_ALERTA DOUBLE NOT NULL)
ALTER TABLE PUBLIC.MEDICAMENTOS ALTER COLUMN ID RESTART WITH 0
CREATE MEMORY TABLE PUBLIC.LOTES_STOCK(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,MEDICAMENTO_ID BIGINT NOT NULL,NUMERO_LOTE VARCHAR(80) NOT NULL,FECHA_CADUCIDAD DATE NOT NULL,PROVEEDOR VARCHAR(150) NOT NULL,CONSTRAINT FK_LOTE_MEDICAMENTO FOREIGN KEY(MEDICAMENTO_ID) REFERENCES PUBLIC.MEDICAMENTOS(ID))
ALTER TABLE PUBLIC.LOTES_STOCK ALTER COLUMN ID RESTART WITH 0
CREATE MEMORY TABLE PUBLIC.MOVIMIENTOS_INVENTARIO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,LOTE_STOCK_ID BIGINT NOT NULL,TIPO_MOVIMIENTO VARCHAR(30) NOT NULL,CANTIDAD DOUBLE NOT NULL,FECHA_HORA TIMESTAMP NOT NULL,VETERINARIO_ID BIGINT,ANIMAL_ID BIGINT,EXPLOTACION_ID BIGINT,PROTOCOLO_EVENTO_ID BIGINT,CONSTRAINT FK_MOVIMIENTO_LOTE FOREIGN KEY(LOTE_STOCK_ID) REFERENCES PUBLIC.LOTES_STOCK(ID))
ALTER TABLE PUBLIC.MOVIMIENTOS_INVENTARIO ALTER COLUMN ID RESTART WITH 0
CREATE MEMORY TABLE PUBLIC.CLINICAS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NOMBRE VARCHAR(150) NOT NULL,TELEFONO VARCHAR(30),EMAIL VARCHAR(160),ACTIVA BOOLEAN DEFAULT TRUE NOT NULL)
ALTER TABLE PUBLIC.CLINICAS ALTER COLUMN ID RESTART WITH 0
CREATE MEMORY TABLE PUBLIC.PROPIETARIOS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,NOMBRE VARCHAR(120) NOT NULL,APELLIDOS VARCHAR(120) NOT NULL,DNI_NIF VARCHAR(20),TELEFONO VARCHAR(30) NOT NULL,EMAIL VARCHAR(160),NOMBRE_NORMALIZADO VARCHAR(250) NOT NULL,NOTIFICACIONES_INTERNAS BOOLEAN DEFAULT TRUE NOT NULL,ACTIVO BOOLEAN DEFAULT TRUE NOT NULL,CONSTRAINT FK_PROPIETARIO_CLINICA FOREIGN KEY(CLINICA_ID) REFERENCES PUBLIC.CLINICAS(ID))
ALTER TABLE PUBLIC.PROPIETARIOS ALTER COLUMN ID RESTART WITH 0
CREATE INDEX IDX_PROPIETARIOS_CLINICA_NOMBRE ON PUBLIC.PROPIETARIOS(CLINICA_ID,NOMBRE_NORMALIZADO)
CREATE INDEX IDX_PROPIETARIOS_CLINICA_TELEFONO ON PUBLIC.PROPIETARIOS(CLINICA_ID,TELEFONO)
CREATE INDEX IDX_PROPIETARIOS_CLINICA_DNI ON PUBLIC.PROPIETARIOS(CLINICA_ID,DNI_NIF)
CREATE MEMORY TABLE PUBLIC.PACIENTES_MASCOTAS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,PROPIETARIO_ID BIGINT NOT NULL,NOMBRE VARCHAR(100) NOT NULL,NOMBRE_NORMALIZADO VARCHAR(100) NOT NULL,ESPECIE VARCHAR(20) NOT NULL,RAZA VARCHAR(100),RAZA_NORMALIZADA VARCHAR(100),MICROCHIP VARCHAR(30),FECHA_NACIMIENTO DATE,FECHA_NACIMIENTO_ESTIMADA BOOLEAN DEFAULT FALSE NOT NULL,EDAD_APROX_ANOS INTEGER,EDAD_APROX_MESES INTEGER,SEXO VARCHAR(20) DEFAULT 'DESCONOCIDO' NOT NULL,ESTERILIZADO VARCHAR(20) DEFAULT 'DESCONOCIDO' NOT NULL,PESO_INICIAL DOUBLE,UNIDAD_PESO VARCHAR(2),ALERGIAS BOOLEAN DEFAULT FALSE NOT NULL,MANEJO_NERVIOSO BOOLEAN DEFAULT FALSE NOT NULL,PATOLOGIA_CRONICA BOOLEAN DEFAULT FALSE NOT NULL,NOTA_BANDERAS VARCHAR(500),ACTIVO BOOLEAN DEFAULT TRUE NOT NULL,ESTADO_PACIENTE VARCHAR(20) DEFAULT 'ACTIVO' NOT NULL,NOTAS VARCHAR(1000),CONSTRAINT FK_PACIENTE_CLINICA FOREIGN KEY(CLINICA_ID) REFERENCES PUBLIC.CLINICAS(ID),CONSTRAINT FK_PACIENTE_PROPIETARIO FOREIGN KEY(PROPIETARIO_ID) REFERENCES PUBLIC.PROPIETARIOS(ID),CONSTRAINT UQ_PACIENTE_MICROCHIP_CLINICA UNIQUE(CLINICA_ID,MICROCHIP))
ALTER TABLE PUBLIC.PACIENTES_MASCOTAS ALTER COLUMN ID RESTART WITH 0
CREATE INDEX IDX_PACIENTES_CLINICA_ESPECIE_RAZA ON PUBLIC.PACIENTES_MASCOTAS(CLINICA_ID,ESPECIE,RAZA)
CREATE INDEX IDX_PACIENTES_MICROCHIP ON PUBLIC.PACIENTES_MASCOTAS(MICROCHIP)
CREATE MEMORY TABLE PUBLIC.CONSULTAS_CLINICAS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,PACIENTE_ID BIGINT NOT NULL,PROPIETARIO_ID BIGINT NOT NULL,FECHA_CONSULTA TIMESTAMP NOT NULL,MOTIVO VARCHAR(500),NOTAS VARCHAR(2000),PROXIMA_VACUNA DATE,CONSTRAINT FK_CONSULTA_CLINICA FOREIGN KEY(CLINICA_ID) REFERENCES PUBLIC.CLINICAS(ID),CONSTRAINT FK_CONSULTA_PACIENTE FOREIGN KEY(PACIENTE_ID) REFERENCES PUBLIC.PACIENTES_MASCOTAS(ID),CONSTRAINT FK_CONSULTA_PROPIETARIO FOREIGN KEY(PROPIETARIO_ID) REFERENCES PUBLIC.PROPIETARIOS(ID))
ALTER TABLE PUBLIC.CONSULTAS_CLINICAS ALTER COLUMN ID RESTART WITH 0
CREATE MEMORY TABLE PUBLIC.RECETAS_CLINICAS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CLINICA_ID BIGINT NOT NULL,CONSULTA_ID BIGINT NOT NULL,PACIENTE_ID BIGINT NOT NULL,MEDICAMENTO_ID BIGINT,LOTE_STOCK_ID BIGINT,INDICACIONES VARCHAR(1000),FECHA_EMISION DATE NOT NULL,CONSTRAINT FK_RECETA_CLINICA FOREIGN KEY(CLINICA_ID) REFERENCES PUBLIC.CLINICAS(ID),CONSTRAINT FK_RECETA_CONSULTA FOREIGN KEY(CONSULTA_ID) REFERENCES PUBLIC.CONSULTAS_CLINICAS(ID),CONSTRAINT FK_RECETA_PACIENTE FOREIGN KEY(PACIENTE_ID) REFERENCES PUBLIC.PACIENTES_MASCOTAS(ID))
ALTER TABLE PUBLIC.RECETAS_CLINICAS ALTER COLUMN ID RESTART WITH 0
